{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true,
    "webextensions": true
  },
  "rules": {
    "no-undef": "error"
  },
  "globals": {
    "WebPilotSemantics": "readonly"
  },
  "ignorePatterns": [
    "extension/vendor/**"
  ]
}
